# Meta Model API key (https://dev.meta.ai). Never commit the real value.
MODEL_API_KEY=

# Supabase project (Project Settings > API). The anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings > API). Server only: never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
MODEL_API_BASE_URL=https://api.meta.ai/v1
GENERATION_MODEL=muse-spark-1.3
VERIFICATION_MODEL=muse-wonder-1.0
