# Meta Model API key (https://dev.meta.ai). Never commit the real value.
MODEL_API_KEY=

# Supabase project (Project Settings > API). The anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings > API). Server only: never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Baseten API key (https://app.baseten.co/settings/api_keys), for Muse Spark Open. Without it, Muse Spark is used.
c
# The tutor's voice (Kokoro on Modal, see modal/tts.py). TTS_URL is printed by `modal deploy`; TTS_TOKEN is any
# long random string, the same one given to `modal deploy`. Without them, the device's own voice is used.
TTS_URL=
TTS_TOKEN=

# Optional overrides
MODEL_API_BASE_URL=https://api.meta.ai/v1
GENERATION_MODEL=muse-spark-1.3
VERIFICATION_MODEL=muse-wonder-1.0
OPEN_MODEL=meta-models/muse-spark-open-1026
